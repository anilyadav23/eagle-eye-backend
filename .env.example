# Environment Configuration
ENVIRONMENT=production
DEBUG=False
PORT=8000

# Database Configuration (SQLite default; automatically connects to PostgreSQL if set)
# SQLite: sqlite:///data/eagle_eye.db
# PostgreSQL / Supabase: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///data/eagle_eye.db

# Storage backend ("local" or "s3")
STORAGE_BACKEND=local

# CORS Origins (comma-separated origins, or * for all)
CORS_ORIGINS=*

# JWT Security
JWT_SECRET_KEY=eagle-eye-super-secret-production-jwt-key-2026-secure
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Cloud S3 Object Storage (optional for DigitalOcean Spaces / AWS S3)
S3_ENDPOINT_URL=
S3_BUCKET=eagle-eye-vault
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
